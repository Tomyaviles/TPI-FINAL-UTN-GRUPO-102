# Copiar este archivo como .env.local y completar con los datos del proyecto de Supabase
# (Supabase → Project Settings → API Keys). El .env.local NO se sube al repo.
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Secret key (Project Settings → API Keys → Secret keys). Solo la usa el servidor
# para crear usuarios desde la pantalla Usuarios. NO compartirla ni subirla.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxx
